{
  "name": "event-media-uploader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.json",
    "lint": "biome ci .",
    "lint:error": "biome ci . --diagnostic-level=error",
    "lint:fix": "biome check . --fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "concurrently": "^9.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@smui/button": "9.0.2",
    "@smui/linear-progress": "^9.0.2",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^181.0.0",
    "svelte": "^5.38.7"
  }
}
